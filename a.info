用法: a [機密筆記內容/支援多行]    # 追加寫入年度机密档案
      cat 檔案 | a                 # 管道串流
      a -e [文件名]                # 强制加密模式
      a -p [密碼] [檔案]           # 對稱 S2K 密碼防窮舉加密
      a -x [文件名]                # 解密一層加密封裝
      a -n [文件名] [文件內容]     # 創建新文件 在雲端/本地
      a -m [文件名] [新文件名]     # 重命名
      a -f [文件名]                # 删除档案/远端档案
      a -t [標籤] [密鑰]           # 新增TOTP 註冊驗證密鑰
		-t                         # 打印所有TOTP标签
		-t [标签]                  # 列印6为动态码
      a -k                         # 金鑰審計清單
      a -a                         # 解密並列印今年度機密文檔
	    -aes                       # 加密推送年度机密档案
		-aus                       # 明文推送年度机密档案
      a -s [文件名]                # 推送
      a -u                         # 强制明文模式
      a -l                         # 檢索雲端 Gist 倉庫全部檔案清單
      a -d [文件名]                # 下載
      a -o [目標路徑或./]          # 指定檔名/本地操作
      a -r1 或 a -r 1              # 刪除年度机密档案【倒數第 1 行】
      a -r1-100 或 a -r 1-100      # 刪除年度机密档案【倒數 1 至 100 行】
      a -r [關鍵字]                # 刪除年度机密档案 包含該關鍵字的所有行
      a -w 或 a --web              #【網頁管理引擎】啟動 Web 視覺化管理後台
	  a -b                         # 操作全部
	    -bs                        # 推送本地档案目录全部文件,覆盖远端gits仓库
		-bd                        # 拉取远端gits全部文件,覆盖本地档案目录
      a -i [不可参数搭配]          # 系統重新配置 /密钥/gitsID/档案目录/Token
